pico-8 cartridge // http://www.pico-8.com
version 43
__lua__


--this is the second class
function _init()
	cls(0)
	
	x_s = 10
	y_s = 60
	
	reset_blt()
	
	speed = 0
	s_b = rnd(5)
	
	circ_clr=1
	rect_clr=2
end

function _update()
	--x_s=x_s+speed
	y_b=y_b+s_b
	
	
	if btn(0) then
		speed=-1
		x_s=x_s+speed
	end
	
	if btn(1) then
		speed=1
		x_s=x_s+speed
	end
	
	if btn(2) then
		speed=-1
		y_s=y_s+speed
	end
	
		if btn(3) then
		speed=1
		y_s=y_s+speed
	end
	
	--bullet hit
	if abs(x_s-x_b)<4 and abs(y_s-y_b)<4 then
		x_s=64
		y_s=64
		
		reset_blt()
	end
	
	if y_b>=128 then
		reset_blt()
	end
	
	
end

function _draw()
	cls(0)

	spr(1,x_s,y_s)
	spr(2,x_b,y_b)
	--draw_blt()
end

function reset_blt()
	x_b = rnd(120)
	y_b = -4
end

function draw_blt()
	for i=1,10 do
		spr(2,x_b,y_b)
		reset_blt()
	end
end

